---
import { t } from "../i18n/utils";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
---

<section id="trayectoria">
  <div class="container">
    <h2 class="sect-title">
      <span class="accent-dot"></span>
      <span>{t(locale, "development.title")}</span>
    </h2>
    <div class="grid-2">
      <!-- Education -->
      <div class="card tile">
        <div class="icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path
              d="M12 3 2 8l10 5 10-5-5-2.5"
              stroke="var(--accent-yellow)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M7 10v4c0 1.1 2.2 2 5 2s5-.9 5-2v-4"
              stroke="var(--accent-teal)"
              stroke-width="2"></path>
          </svg>
        </div>
        <div>
          <h3>{t(locale, "development.education.title")}</h3>
          <p>{t(locale, "development.education.item1")}</p>
          <p>{t(locale, "development.education.item2")}</p>
        </div>
      </div>

      <!-- Languages -->
      <div class="card tile">
        <div class="icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <title>{t(locale, "development.languages.svgTitle")}</title>
            <circle cx="12" cy="10" r="6" stroke="var(--accent-blue)" stroke-width="2"></circle>
            <path d="M12 4v12" stroke="var(--accent-teal)" stroke-width="2" stroke-linecap="round"
            ></path>
            <path d="M6 10h12" stroke="var(--accent-orange)" stroke-width="2" stroke-linecap="round"
            ></path>
            <path
              d="M7 6.6c2 1.4 6 1.4 10 0"
              stroke="var(--accent-magenta)"
              stroke-width="2"
              stroke-linecap="round"></path>
            <path
              d="M7 13.4c2-1.4 6-1.4 10 0"
              stroke="var(--accent-magenta)"
              stroke-width="2"
              stroke-linecap="round"
              opacity=".8"></path>
          </svg>
        </div>
        <div>
          <h3>{t(locale, "development.languages.title")}</h3>
          <p>{t(locale, "development.languages.spanish")}</p>
          <p>{t(locale, "development.languages.guarani")}</p>
          <p>{t(locale, "development.languages.english")}</p>
          <p>{t(locale, "development.languages.portuguese")}</p>
          <p>{t(locale, "development.languages.french")}</p>
        </div>
      </div>

      <!-- Tech Skills -->
      <div class="card tile">
        <div class="icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <title>{t(locale, "development.techSkills.svgTitle")}</title>
            <path
              d="M9 16L5 12l4-4"
              stroke="var(--accent-teal)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M15 8l4 4-4 4"
              stroke="var(--accent-teal)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M13 7l-2 10"
              stroke="var(--accent-magenta)"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </div>
        <div>
          <h3>{t(locale, "development.techSkills.title")}</h3>
          <p>{t(locale, "development.techSkills.languages")}</p>
          <p>{t(locale, "development.techSkills.frameworks")}</p>
          <p>{t(locale, "development.techSkills.databases")}</p>
          <p>{t(locale, "development.techSkills.tools")}</p>
          <p>{t(locale, "development.techSkills.methodologies")}</p>
          <p>{t(locale, "development.techSkills.other")}</p>
        </div>
      </div>

      <!-- Courses -->
      <div class="card tile">
        <div class="icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <title>{t(locale, "development.courses.svgTitle")}</title>
            <rect x="3" y="5" width="12" height="6" rx="1" stroke="var(--accent-teal)" stroke-width="2"
            ></rect>
            <rect x="5" y="11" width="14" height="6" rx="1" stroke="var(--accent-yellow)" stroke-width="2"
            ></rect>
            <path
              d="M9 5v4l2-1 2 1V5"
              stroke="var(--accent-magenta)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <div>
          <h3>{t(locale, "development.courses.title")}</h3>
          <p>{t(locale, "development.courses.item1")}</p>
          <p>{t(locale, "development.courses.item2")}</p>
          <p>{t(locale, "development.courses.item3")}</p>
          <p>{t(locale, "development.courses.item4")}</p>
          <p>{t(locale, "development.courses.item5")}</p>
          <p>{t(locale, "development.courses.item6")}</p>
        </div>
      </div>

      <!-- Certificates -->
      <div class="card tile">
        <div class="icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <title>{t(locale, "development.certificates.svgTitle")}</title>
            <circle cx="12" cy="8" r="4" stroke="var(--accent-yellow)" stroke-width="2"></circle>
            <path
              d="M10.3 8l1.3 1.3 2-2"
              stroke="var(--accent-teal)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M10 12l-2 4 3-1 1 2"
              stroke="var(--accent-orange)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M14 12l2 4-3-1-1 2"
              stroke="var(--accent-orange)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <div>
          <h3>{t(locale, "development.certificates.title")}</h3>
          <p>{t(locale, "development.certificates.item1")}</p>
          <p>{t(locale, "development.certificates.item2")}</p>
          <p>{t(locale, "development.certificates.item3")}</p>
          <p>{t(locale, "development.certificates.item4")}</p>
          <p>{t(locale, "development.certificates.item5")}</p>
          <p>{t(locale, "development.certificates.item6")}</p>
          <p>{t(locale, "development.certificates.item7")}</p>
          <p>{t(locale, "development.certificates.item8")}</p>
        </div>
      </div>
    </div>
  </div>
</section>
