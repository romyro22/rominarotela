---
import { t } from "../i18n/utils";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const galleryPath = locale === "en" ? "/en/galeria" : "/galeria";
---

<section id="destacados">
  <div class="container">
    <h2 class="sect-title">
      <span
        class="accent-dot"
        style="background:var(--accent-orange);box-shadow:0 0 0 6px #FF8A0030"
      ></span>
      <span>{t(locale, "personalProjects.title")}</span>
    </h2>

    <!-- TAB LIST -->
    <div class="tabs" role="tablist" aria-label="Proyectos destacados">
      <!-- Tab 1 — Emprendimientos -->
      <button
        class="tab-card card"
        role="tab"
        aria-selected="true"
        aria-controls="panel-webdesign"
        id="tab-webdesign"
      >
        <div class="icon" style="background:#3AA0FF22">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <rect
              x="2"
              y="3"
              width="20"
              height="14"
              rx="2"
              stroke="var(--accent-blue)"
              stroke-width="2"></rect>
            <path d="M8 21h8" stroke="var(--accent-blue)" stroke-width="2"></path>
            <path d="M12 17v4" stroke="#fff" opacity=".7"></path>
          </svg>
        </div>
        <div class="tab-texts">
          <strong>{t(locale, "personalProjects.ventures.tab")}</strong>
        </div>
      </button>

      <!-- Tab 2 — Desarrollo web -->
      <button
        class="tab-card card"
        role="tab"
        aria-selected="false"
        aria-controls="panel-dev"
        id="tab-dev"
      >
        <div class="icon" style="background:#22C6C622">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path
              d="M9 18 4 12 9 6"
              stroke="var(--accent-teal)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <path
              d="M15 6 20 12 15 18"
              stroke="var(--accent-teal)"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <div class="tab-texts">
          <strong>{t(locale, "personalProjects.dev.tab")}</strong>
        </div>
      </button>

      <!-- Tab 3 — Ilustracion -->
      <button
        class="tab-card card"
        role="tab"
        aria-selected="false"
        aria-controls="panel-illustration"
        id="tab-illustration"
      >
        <div class="icon" style="background:#FFD24D22">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path
              d="M12 3C7 3 3 7 3 12s3 9 8 9c2 0 1.5-2 3-2h2a3 3 0 0 0 0-6h-1"
              stroke="var(--accent-yellow)"
              stroke-width="2"></path>
            <circle cx="8.5" cy="10" r="1" fill="#FF8A00"></circle>
            <circle cx="11.5" cy="7.5" r="1" fill="#FF3C8E"></circle>
            <circle cx="15" cy="10.5" r="1" fill="#22C6C6"></circle>
          </svg>
        </div>
        <div class="tab-texts">
          <strong>{t(locale, "personalProjects.illustration.tab")}</strong>
        </div>
      </button>

      <!-- Tab 4 — UX/UI -->
      <button
        class="tab-card card"
        role="tab"
        aria-selected="false"
        aria-controls="panel-ux"
        id="tab-ux"
      >
        <div class="icon" style="background:#FF8A0022">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M9 18h6M10 21h4" stroke="var(--accent-orange)" stroke-width="2"></path>
            <path
              d="M12 3a6 6 0 0 0-3 11l1 1.5h4L15 14a6 6 0 0 0-3-11Z"
              stroke="var(--accent-orange)"
              stroke-width="2"></path>
          </svg>
        </div>
        <div class="tab-texts">
          <strong>{t(locale, "personalProjects.ux.tab")}</strong>
        </div>
      </button>
    </div>

    <!-- TAB PANELS -->
    <div class="tab-panels card">
      <!-- Panel 1 — Emprendimientos -->
      <div id="panel-webdesign" role="tabpanel" aria-labelledby="tab-webdesign">
        <div class="panel-wrap">
          <div
            class="panel-media"
            style="background-image:linear-gradient(135deg,#3AA0FF33,#FF3C8E22)"
          >
            <img
              src="/img/emprendimientos.png"
              alt="Emprendimientos"
              class="thumb-img"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="panel-body">
            <h3>{t(locale, "personalProjects.ventures.title")}</h3>
            <p class="muted">
              <p style="margin: 0;">{t(locale, "personalProjects.ventures.p1")}</p>
              <p style="margin: 0;" set:html={t(locale, "personalProjects.ventures.p2")} />
              <p style="margin: 0;" set:html={t(locale, "personalProjects.ventures.p3")} />
              <p style="margin: 0;">{t(locale, "personalProjects.ventures.p4")}</p>
            </p>
            <div class="panel-cta">
              <a
                class="btn btn-ghost"
                target="_blank"
                rel="noopener noreferrer"
                href="https://www.instagram.com/creaciones_romy_rotela?igsh=ZTI0NmM4dXd1djN5"
                style="margin-right: 15px;"
              >
                creaciones_romy_rotela
              </a>
              <a
                class="btn btn-ghost"
                target="_blank"
                rel="noopener noreferrer"
                href="https://www.instagram.com/rotibapy?igsh=MXQwdm1seTg4a2R1Ng=="
              >
                rotibapy
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel 2 — Desarrollo web -->
      <div id="panel-dev" role="tabpanel" aria-labelledby="tab-dev" hidden>
        <div class="panel-wrap">
          <div
            class="panel-media"
            style="background-image:linear-gradient(135deg,#22C6C633,#FFD24D22)"
          >
            <img
              src="/img/programacion.png"
              alt="Programacion"
              class="thumb-img"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="panel-body">
            <h3>{t(locale, "personalProjects.dev.title")}</h3>
            <p class="muted">
              <p style="margin: 0;">{t(locale, "personalProjects.dev.p1")}</p>
              <p style="margin: 0;">{t(locale, "personalProjects.dev.p2")}</p>
              <p style="margin: 0;">{t(locale, "personalProjects.dev.p3")}</p>
              <p style="margin: 0;">{t(locale, "personalProjects.dev.p4")}</p>
            </p>
            <div class="panel-cta">
              <a
                class="btn btn-ghost"
                target="_blank"
                rel="noopener noreferrer"
                href="https://github.com/romyro22"
              >
                {t(locale, "personalProjects.dev.viewRepo")}
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel 3 — Ilustracion -->
      <div id="panel-illustration" role="tabpanel" aria-labelledby="tab-illustration" hidden>
        <div class="panel-wrap">
          <div
            class="panel-media"
            style="background-image:linear-gradient(135deg,#FFD24D33,#FF8A0022)"
          >
            <img
              src="/img/ilustracion.png"
              alt="Ilustraciones"
              class="thumb-img"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="panel-body">
            <h3>{t(locale, "personalProjects.illustration.title")}</h3>
            <p class="muted">
              <p style="margin: 0;">{t(locale, "personalProjects.illustration.p1")}</p>
              <p style="margin: 0;">{t(locale, "personalProjects.illustration.p2")}</p>
              <p style="margin: 0;">{t(locale, "personalProjects.illustration.p3")}</p>
              <p style="margin: 0;">{t(locale, "personalProjects.illustration.p4")}</p>
            </p>
            <div class="panel-cta">
              <a class="btn btn-ghost" href={galleryPath}>
                {t(locale, "personalProjects.illustration.gallery")}
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Panel 4 — UX/UI -->
      <div id="panel-ux" role="tabpanel" aria-labelledby="tab-ux" hidden>
        <div class="panel-wrap">
          <div
            class="panel-media"
            style="background-image:linear-gradient(135deg,#FF8A0033,#3AA0FF22)"
          >
            <img
              src="/img/figma.png"
              alt="ux-ui"
              class="thumb-img"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="panel-body">
            <h3>{t(locale, "personalProjects.ux.title")}</h3>
            <p class="muted">
              <p style="margin: 0;">{t(locale, "personalProjects.ux.p1")}</p>
              <p style="margin: 0;">{t(locale, "personalProjects.ux.p2")}</p>
              <p style="margin: 0;">{t(locale, "personalProjects.ux.p3")}</p>
              <p style="margin: 0;">{t(locale, "personalProjects.ux.p4")}</p>
            </p>
            <div class="panel-cta">
              <a
                class="btn btn-ghost"
                target="_blank"
                rel="noopener noreferrer"
                href="https://www.figma.com/@romyrotela"
              >
                {t(locale, "personalProjects.ux.viewPrototype")}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const tablist = document.querySelector("#destacados .tabs");
    if (!tablist) return;
    const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
    const panels = tabs.map((tab) =>
      document.getElementById(tab.getAttribute("aria-controls") ?? ""),
    );

    function activateTab(tab: Element) {
      tabs.forEach((t, i) => {
        const selected = t === tab;
        t.setAttribute("aria-selected", String(selected));
        const panel = panels[i];
        if (panel) {
          panel.hidden = !selected;
        }
      });
      (tab as HTMLElement).focus();
    }

    tabs.forEach((t) => t.addEventListener("click", () => activateTab(t)));

    tablist.addEventListener("keydown", (e) => {
      const idx = tabs.indexOf(document.activeElement as Element);
      if (idx < 0) return;
      let next: Element | null = null;
      switch ((e as KeyboardEvent).key) {
        case "ArrowRight":
        case "ArrowDown":
          next = tabs[(idx + 1) % tabs.length];
          break;
        case "ArrowLeft":
        case "ArrowUp":
          next = tabs[(idx - 1 + tabs.length) % tabs.length];
          break;
        case "Home":
          next = tabs[0];
          break;
        case "End":
          next = tabs[tabs.length - 1];
          break;
      }
      if (next) {
        e.preventDefault();
        activateTab(next);
      }
    });
  })();
</script>
